#!/bin/sh
set -eu
scanner="${GITLEAKS_BIN:-gitleaks}"
if ! command -v "$scanner" >/dev/null 2>&1; then
  echo "Push blocked: install Gitleaks or set GITLEAKS_BIN to your verified scanner." >&2
  exit 1
fi
exec "$scanner" git . --config .gitleaks.toml --log-opts=--all --redact=100 --no-banner
