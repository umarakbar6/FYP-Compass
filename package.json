{
  "name": "fyp-compass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build:demo": "tsc -b && vite build --mode demo",
    "check:connection": "node scripts/check-connection.mjs",
    "package:handover": "node scripts/package-handover.mjs",
    "accounts:prepare": "node scripts/setup-demo-accounts.mjs --prepare",
    "accounts:provision": "node scripts/setup-demo-accounts.mjs --provision",
    "test:accounts": "node --test scripts/demo-accounts.test.mjs",
    "test:database": "npm --prefix backend/local-tests test",
    "dev:v2": "vite --host 127.0.0.1 --mode v2",
    "build:v2": "tsc -b && vite build --mode v2",
    "local:server": "node backend/local-tests/local-server.mjs",
    "demo:local": "node scripts/start-local-demo.mjs",
    "dev:local": "vite --host 127.0.0.1 --port 5182 --strictPort --mode localbackend",
    "test:local-http": "node --test backend/local-tests/local-http.test.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "test:cloud": "node --test scripts/cloud-config.test.mjs scripts/browser-security.test.mjs scripts/provider-environment.test.mjs scripts/release-integrity.test.mjs",
    "seed:local-audit": "node scripts/seed-local-audit.cjs",
    "test:mvp": "node scripts/audit-ten-cases.mjs",
    "backup:verify": "node backend/local-tests/backup-restore.mjs",
    "test:production": "node --test backend/local-tests/production-database.test.mjs",
    "format": "prettier --write src backend/agents scripts/*.mjs",
    "format:check": "prettier --check src backend/agents",
    "lint": "eslint src backend/agents",
    "test:e2e": "npm run build:demo && playwright test",
    "test:review": "node --test backend/local-tests/review-database.test.mjs",
    "db:generate": "node scripts/generate-installers.mjs",
    "db:check": "node scripts/generate-installers.mjs --check",
    "configure:deployment": "node scripts/configure-deployment.mjs",
    "test:email": "node --test backend/email/*.test.mjs",
    "security:check": "node scripts/security-check.mjs",
    "test:local-browser": "node e2e/connected-local-audit.cjs",
    "test:report-print": "node e2e/report-print-check.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/supabase-js": "^2.57.4",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "nodemailer": "10.1.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  }
}
